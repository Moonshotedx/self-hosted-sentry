COMPOSE_PROJECT_NAME=sentry-self-hosted
# Set COMPOSE_PROFILES to "feature-complete" to enable all features
# To enable errors monitoring only, set COMPOSE_PROFILES=errors-only
# See https://develop.sentry.dev/self-hosted/optional-features/errors-only/
# Used only by docker-compose (single-node). docker-stack.yml (Swarm) ignores
# profiles and runs all 72 services unconditionally — see docs/multinode-setup.md.
COMPOSE_PROFILES=feature-complete
# 100K-users/day with replays on <500 GB disks: 90-day retention will OOM ClickHouse
# and run SeaweedFS out of space within weeks. 7 days keeps usage flat.
SENTRY_EVENT_RETENTION_DAYS=7
# You can either use a port number or an IP:PORT combo for SENTRY_BIND
# See https://docs.docker.com/compose/compose-file/#ports for more
SENTRY_BIND=9000
# Set SENTRY_MAIL_HOST to a valid FQDN (host/domain name) to be able to send emails!
# SENTRY_MAIL_HOST=example.com
# Parallel taskworker processes (higher values increase memory usage; >32 not recommended)
# 24 chosen for the 100K-users/day multinode deploy where taskworker runs on BM2 (48 GB).
SENTRY_TASKWORKER_CONCURRENCY=24
SENTRY_IMAGE=ghcr.io/getsentry/sentry:26.4.2
SNUBA_IMAGE=ghcr.io/getsentry/snuba:26.4.2
RELAY_IMAGE=ghcr.io/getsentry/relay:26.4.2
SYMBOLICATOR_IMAGE=ghcr.io/getsentry/symbolicator:26.4.2
TASKBROKER_IMAGE=ghcr.io/getsentry/taskbroker:26.4.2
VROOM_IMAGE=ghcr.io/getsentry/vroom:26.4.2
UPTIME_CHECKER_IMAGE=ghcr.io/getsentry/uptime-checker:26.4.2
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=1m30s
HEALTHCHECK_RETRIES=10
HEALTHCHECK_START_PERIOD=10s
HEALTHCHECK_FILE_INTERVAL=60s
HEALTHCHECK_FILE_TIMEOUT=10s
HEALTHCHECK_FILE_RETRIES=3
HEALTHCHECK_FILE_START_PERIOD=600s
# Set SETUP_JS_SDK_ASSETS to 1 to enable the setup of JS SDK assets
# SETUP_JS_SDK_ASSETS=1
#
# Set SETUP_CUSTOM_CA_CERTIFICATE to 1 to generate trust stores that inject
# your custom CA certificates (from ./certificates/*.crt) into non-Sentry
# services (relay, symbolicator, vroom, snuba, taskbroker, uptime-checker).
# Re-run ./install.sh after adding or changing certificates — no Docker image
# rebuilds are required. Follow the printed instructions to update your
# docker-compose.override.yml on the first run.
# SETUP_CUSTOM_CA_CERTIFICATE=1
#
# Sentry (and its' surrounding services) uses Statsd for metrics collection.
# It's also the proper way to monitor self-hosted Sentry systems.
# Set STATSD_ADDR to a valid IP:PORT combination to enable Statsd metrics collection.
# STATSD_ADDR=127.0.0.1:8125
#
# ── Multinode / Swarm deploy variables ──────────────────────────────────────────
# Only needed when running docker-stack.yml across BM1/BM2/BM3. See
# docs/multinode-setup.md for the full operator guide.
#
# Replay & profile blob storage. For the 3-BM deployment we recommend pointing
# these at an EXTERNAL S3-compatible service (MinIO, AWS S3, R2, B2) so the
# multi-TB replay corpus doesn't fill the local 500 GB NVMe on BM2.
# When unset, falls back to the in-cluster seaweedfs container.
# SENTRY_BUCKET_PROFILES=s3://profiles?region=us-east-1&endpoint=s3.example.com&s3ForcePathStyle=true
# SENTRY_PROFILES_S3_ACCESS_KEY=
# SENTRY_PROFILES_S3_SECRET_KEY=
